# 单机构建时可选默认 SSH（第三参 ALL 或不带节点时使用）
SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY=~/.ssh/id_rsa
# SSH_PASS=your_ssh_password
REMOTE_SUDO=1

# 分布式：与 --node 对应（AWS 两台相同密钥/ubuntu/sudo 即可）
NODE_POLY_HOST=54.65.44.140
NODE_SXBET_HOST=52.215.36.68
# NODE_PRED_HOST=

MALL_APP_DIR=/www/wwwroot/arbopp
MALL_BOT_RUN_CONF=test
ARBOPP_USE_GO_RUN=1
ARBOPP_GO_ROOT=/usr/local/go

GIT_FETCH_TIMEOUT=120
GIT_REPO_URL=git@github.com:qingpeng2016/arbopp.git