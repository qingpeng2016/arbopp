# 单机构建时可选默认 SSH（第三参 ALL 或不带节点时使用）
SSH_HOST=your.server.public.ip
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY=~/.ssh/your-default.pem
# SSH_PASS=your_ssh_password
REMOTE_SUDO=1

# 分布式：SSH 始终用各机公网 IP；relay 在 node_route 里配置私网 10.x:9000
NODE_POLY_HOST=46.51.144.94
NODE_POLY_SSH_KEY=/Users/qing/aws/arb-aws-key-ael.pem
NODE_PRED_HOST=18.176.194.218
NODE_PRED_SSH_KEY=/Users/qing/aws/arb-aws-key-jd.pem
# NODE_SXBET_HOST=
# NODE_SXBET_SSH_KEY=

MALL_APP_DIR=/www/wwwroot/arbopp
MALL_BOT_RUN_CONF=test
ARBOPP_USE_GO_RUN=1
ARBOPP_GO_ROOT=/usr/local/go

GIT_FETCH_TIMEOUT=120
GIT_REPO_URL=git@github.com:qingpeng2016/arbopp.git