SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=ubuntu
# 密钥登录（推荐，如 AWS EC2）：设 SSH_KEY 后无需 SSH_PASS、sshpass
SSH_KEY=~/.ssh/id_rsa
# 密码登录（阿里云 root 等）：注释掉 SSH_KEY，填写 SSH_PASS
# SSH_PASS=your_ssh_password
# 代码目录属主 root、SSH 为 ubuntu 时必开（等同 sudo -i 后部署）
REMOTE_SUDO=1

MALL_APP_DIR=/www/wwwroot/arbopp
MALL_BOT_RUN_CONF=test
ARBOPP_USE_GO_RUN=1
ARBOPP_GO_ROOT=/usr/local/go

GIT_FETCH_TIMEOUT=120
GIT_REPO_URL=git@github.com:qingpeng2016/arbopp.git